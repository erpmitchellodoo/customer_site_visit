<odoo><template id="report_site_visit_document"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page"><h2>Customer Site Visit Report - <span t-field="o.name"/></h2><div class="row"><div class="col-6"><strong>Customer:</strong> <span t-field="o.partner_id"/><br/><strong>Visit Type:</strong> <span t-field="o.visit_type_id"/><br/><strong>Responsible:</strong> <span t-field="o.user_id"/></div><div class="col-6"><strong>Planned:</strong> <span t-field="o.planned_start"/><br/><strong>Check In:</strong> <span t-field="o.check_in"/><br/><strong>Check Out:</strong> <span t-field="o.check_out"/></div></div><hr/><h4>Site Address</h4><p t-field="o.site_address"/><h4>Purpose</h4><p t-field="o.purpose"/><h4>Checklist</h4><table class="table table-sm"><thead><tr><th>Done</th><th>Item</th><th>Notes</th></tr></thead><tbody><tr t-foreach="o.checklist_ids" t-as="l"><td><span t-esc="'Yes' if l.done else 'No'"/></td><td><span t-field="l.name"/></td><td><span t-field="l.notes"/></td></tr></tbody></table><h4>Findings / Follow-up</h4><table class="table table-sm"><thead><tr><th>Finding</th><th>Action</th><th>Responsible</th><th>Deadline</th></tr></thead><tbody><tr t-foreach="o.finding_ids" t-as="f"><td><span t-field="f.name"/></td><td><span t-field="f.action"/></td><td><span t-field="f.responsible_id"/></td><td><span t-field="f.deadline"/></td></tr></tbody></table><h4>Observations</h4><div t-field="o.observations"/><h4>Recommendations</h4><div t-field="o.recommendation"/><h4>Customer Acknowledgement</h4><p><strong>Name:</strong> <span t-field="o.customer_name"/></p><p t-field="o.customer_comments"/><img t-if="o.customer_signature" t-att-src="image_data_uri(o.customer_signature)" style="max-height:120px;max-width:300px;"/></div></t></t></t></template></odoo>
