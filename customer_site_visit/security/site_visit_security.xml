<odoo>
    <!-- Match Sales ownership rules; company restrictions apply to every group. -->
    <record id="rule_site_visit_company" model="ir.rule">
        <field name="name">Site Visit: multi-company</field>
        <field name="model_id" ref="model_customer_site_visit"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(5, 0, 0)]"/>
    </record>
    <record id="rule_site_visit_personal" model="ir.rule">
        <field name="name">Site Visit: own documents</field>
        <field name="model_id" ref="model_customer_site_visit"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('user_id', '=', False)]</field>
        <field name="groups" eval="[(6, 0, [ref('sales_team.group_sale_salesman')])]"/>
    </record>
    <record id="rule_site_visit_all" model="ir.rule">
        <field name="name">Site Visit: all documents</field>
        <field name="model_id" ref="model_customer_site_visit"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('sales_team.group_sale_salesman_all_leads')])]"/>
    </record>
    <record id="rule_site_visit_checklist_company" model="ir.rule">
        <field name="name">Site Visit Checklist: multi-company</field>
        <field name="model_id" ref="model_customer_site_visit_checklist"/>
